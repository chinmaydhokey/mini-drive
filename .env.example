# ======================
# API Server
# ======================
NODE_ENV=development
PORT=3000

# MongoDB
MONGO_URI=mongodb://localhost:27017/minidrive

# JWT
JWT_ACCESS_SECRET=your-access-secret-change-me-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-me-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Redis (Phase 7+)
REDIS_URL=redis://localhost:6379

# AWS S3 (Phase 10+)
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Internal service secret (Phase 6+)
INTERNAL_SECRET=internal-secret-change-me

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173
